# =============================================================================
# SignalMap v2 backend — sample environment file (source build / dev)
# =============================================================================
# This is the dev-time companion to deploy/.env.example. Use this when running
# the source-build compose at the repo root (docker compose up -d --build).
# Use deploy/.env.example when pulling pre-built images from GHCR.
#
# Copy this file to .env at the repo root, then fill in the values you need.
#   Bash:       cp docker/signalmap-shared.env.example .env
#   PowerShell: Copy-Item docker/signalmap-shared.env.example .env
#
# Then bring the stack up:
#   docker compose up -d --build --force-recreate
#
# DO NOT commit .env. The repo's .gitignore excludes .env / .env.local.
#
# Only the values ACTIVE in this file are required. Everything in the
# OPTIONAL OVERRIDES section at the bottom is commented out because the
# code + compose files have sensible defaults — uncomment a line only when
# you actually want to deviate from the documented default.
# =============================================================================

# ── Backend mode ────────────────────────────────────────────────────────────
# live:    real OpenRouter + Perplexity + Cloudflare Radar (costs apply).
# fixture: deterministic dev mode, no real LLM calls — useful for UI work
#          or running without keys.
SIGNALMAP_BACKEND_MODE=live

# ── Redis (REQUIRED) ────────────────────────────────────────────────────────
# Strong random password. The compose file fail-fasts at "config" if unset.
# Avoid URL-reserved characters (/, +, ?, #, @, :) until ioredis URL parsing
# is hardened; use [A-Za-z0-9_-] only.
#   openssl rand -base64 24 | tr '+/=' '_-_'
REDIS_PASSWORD=change-me-strong-random

# ── Admin token (REQUIRED for the "refresh now" UI button + /brief/refresh) ─
# Without this, admin endpoints reject every request and the refresh button
# stays hidden. Path resolves under the secrets/ directory at the repo root.
# The .example placeholder is safe for local dev only — generate a real one
# for any deployment that's reachable beyond localhost.
SIGNALMAP_ADMIN_TOKEN_FILE=./secrets/SIGNALMAP_ADMIN_TOKEN.example

# ── LLM keys (REQUIRED in live mode) ────────────────────────────────────────
# Validate after pasting:
#   sudo bash scripts/ops/test-env-keys.sh .env
OPENROUTER_API_KEY=sk-or-v1-replace-me
PERPLEXITY_API_KEY=pplx-replace-me

# ── Optional but recommended ────────────────────────────────────────────────
# NewsAPI: free dev plan is ~100 req/day. Without this the news pipeline
# still works (Hacker News + Dark Reading RSS); just no NewsAPI top-headlines.
NEWSAPI_API_KEY=

# Cloudflare Radar: works UNAUTH at lower rate limits. Set this for higher
# limits and authenticated endpoints. Token needs:
#   Account.Cloudflare Radar:Read, Account.Account Settings:Read
CLOUDFLARE_API_TOKEN=


# =============================================================================
# OPTIONAL OVERRIDES — leave commented out unless you specifically need them
# =============================================================================

# ── Host port (default 8080) ────────────────────────────────────────────────
#SIGNALMAP_PORT=8080

# ── OpenRouter base URL (default: official endpoint) ────────────────────────
# Override only for self-hosted proxies (LiteLLM, custom gateway, air-gapped).
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Model selection (default: provider's choice) ────────────────────────────
# Comma-separated fallback chain. Empty = OpenRouter picks based on routing.
#SIGNALMAP_LLM_MODELS=anthropic/claude-sonnet-4.6,nvidia/nemotron-3-super-120b-a12b,moonshotai/kimi-k2_6,google/gemini-3.1-pro-preview

# ── Cost / quality tuning ───────────────────────────────────────────────────
#SIGNALMAP_LLM_MAX_OUTPUT_TOKENS=768
#SIGNALMAP_EVENT_CONFIDENCE_MIN=0.7
#SIGNALMAP_VECTOR_MIN_SCORE=0.72

# ── Window + cadence (defaults: 24h window, 6h cold-boot, 60min RSS, 30min brief) ──
#SIGNALMAP_NEWS_WINDOW_HOURS=24
#SIGNALMAP_NEWS_COLD_BOOT_HOURS=6
#SIGNALMAP_NEWS_ITEMS_PER_SOURCE=5
#SIGNALMAP_RSS_POLL_MINUTES=60
#SIGNALMAP_BRIEF_REFRESH_MINUTES=30

# ── Budget (default $2/day) ─────────────────────────────────────────────────
#SIGNALMAP_DAILY_LLM_BUDGET_USD=2.00

# ── Vector store ────────────────────────────────────────────────────────────
#SIGNALMAP_VECTOR_ENABLED=true
#SIGNALMAP_EMBEDDING_MODEL=openai/text-embedding-3-small
#SIGNALMAP_EMBEDDING_DIM=1536

# ── NewsAPI page size (default 20) ──────────────────────────────────────────
#NEWSAPI_PAGE_SIZE=20

# ── Distill (path inside container — only override for custom bind-mounts) ──
#SIGNALMAP_DISTILL_ROOT=/app/vendor/distill
#SIGNALMAP_DISTILL_TIMEOUT_MS=15000

# ── Worker leases + SSE heartbeat (defaults are fine for almost all setups) ─
#SIGNALMAP_COLLECTOR_LEASE_TTL_SEC=60
#SIGNALMAP_CRON_LEASE_TTL_SEC=60
#SSE_HEARTBEAT_SECONDS=20

# ── Brief per-event tuning (defaults: $0.05 est cost, 20/min, 5min lock) ────
#SIGNALMAP_BRIEF_EVENT_EST_COST_USD=0.05
#SIGNALMAP_BRIEF_PER_EVENT_RATE_LIMIT_PER_MIN=20
#SIGNALMAP_BRIEF_PER_EVENT_LOCK_TIMEOUT_SECONDS=300
