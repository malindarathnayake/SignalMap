# ============================================================================
# SignalMap v2 backend — sample environment file
# ============================================================================
# Copy this file to .env at the repo root, then fill in the values you need.
#   Bash:       cp docker/signalmap-shared.env.example .env
#   PowerShell: Copy-Item docker/signalmap-shared.env.example .env
#
# Then bring the stack up:
#   docker compose up -d --build --force-recreate
#
# DO NOT commit .env. The repo's .gitignore excludes .env / .env.local.
# ============================================================================

# ── Backend mode ────────────────────────────────────────────────────────────
# fixture: deterministic dev mode, no real LLM calls.
# live:    real OpenRouter + Perplexity + Cloudflare Radar (costs apply).
SIGNALMAP_BACKEND_MODE=live

# ── Redis (required) ────────────────────────────────────────────────────────
# Strong random password. The compose file fail-fasts at "config" if unset.
# Avoid URL-reserved characters (/, +, ?, #, @, :) until ioredis URL parsing
# is hardened (Phase 5.5 deferred finding); use [A-Za-z0-9_-] only.
REDIS_PASSWORD=change-me-strong-random

# ── LLM keys (required in live mode) ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PERPLEXITY_API_KEY=pplx-replace-me

# Optional — comma-separated model fallback chain.
SIGNALMAP_LLM_MODELS=anthropic/claude-sonnet-4.6,nvidia/nemotron-3-super-120b-a12b,moonshotai/kimi-k2_6,google/gemini-3.1-pro-preview

# Cap on LLM response tokens for article event extraction. Default 768 fits
# the structured-JSON event schema with comfortable headroom and avoids 402
# Payment Required responses on tiered accounts where the model's full
# output window (e.g. 65k tokens) exceeds the per-request credit allowance.
SIGNALMAP_LLM_MAX_OUTPUT_TOKENS=768

# ── Cloudflare Radar (optional — works unauth at lower limits) ──────────────
CLOUDFLARE_API_TOKEN=

# NewsAPI (optional; free/dev plans are commonly 100 requests/day)
# The collector sends this as X-Api-Key and polls hourly by default.
NEWSAPI_API_KEY=
NEWSAPI_PAGE_SIZE=20
SIGNALMAP_NEWS_ITEMS_PER_SOURCE=5

# Cold-boot publishedAt cutoff (hours). When the persistent dedupe set is
# empty (fresh container, wiped volumes), the RSS feed has 100+ articles
# spanning days of history; without this cutoff every one gets a paid LLM
# call. 6h trades the backfill for a much cheaper cold start. Subsequent
# warm ticks use the dedupe set and ignore this setting. Set 0 to disable.
SIGNALMAP_NEWS_COLD_BOOT_HOURS=6

# Per-event confidence floor (0..1). Articles parsed below this are dropped
# with reason `low_signal_confidence` before geocoding/embedding. Defaults
# to 0.7 — tuned to filter sports / celebrity / animal-interest / routine
# local commodity / local-agriculture stories the LLM is told to score low.
SIGNALMAP_EVENT_CONFIDENCE_MIN=0.7

# Distill article extraction for The Hacker News.
# The Distill runtime is vendored into this repo and copied into the container.
SIGNALMAP_DISTILL_ROOT=/app/vendor/distill
SIGNALMAP_DISTILL_TIMEOUT_MS=15000

# ── Admin token (file-based via Docker secret) ──────────────────────────────
# Mandatory: path to a file containing the admin token. The compose
# secrets block resolves this and exposes it inside the api+cron containers
# as /run/secrets/SIGNALMAP_ADMIN_TOKEN. The example placeholder file is
# safe for local dev only.
SIGNALMAP_ADMIN_TOKEN_FILE=./secrets/SIGNALMAP_ADMIN_TOKEN.example

# ── Cadence + budget ────────────────────────────────────────────────────────
SIGNALMAP_RSS_POLL_MINUTES=60
SIGNALMAP_BRIEF_REFRESH_MINUTES=30
SIGNALMAP_DAILY_LLM_BUDGET_USD=2.00
SIGNALMAP_BRIEF_EVENT_EST_COST_USD=0.05
SIGNALMAP_BRIEF_PER_EVENT_RATE_LIMIT_PER_MIN=20

# ── Lease TTLs ──────────────────────────────────────────────────────────────
SIGNALMAP_COLLECTOR_LEASE_TTL_SEC=60
SIGNALMAP_CRON_LEASE_TTL_SEC=60

# ── SSE ─────────────────────────────────────────────────────────────────────
SSE_HEARTBEAT_SECONDS=20

# ── Vector store toggle ─────────────────────────────────────────────────────
SIGNALMAP_VECTOR_ENABLED=true

# ── Embeddings ──────────────────────────────────────────────────────────────
# openai/text-embedding-3-small via OpenRouter (no separate API key needed).
# 1536 dim, ~$0.02/M tokens; ~140 articles/day costs ~$0.01/month.
SIGNALMAP_EMBEDDING_MODEL=openai/text-embedding-3-small
SIGNALMAP_EMBEDDING_DIM=1536

# ── Host port (compose maps to ui container's :8080) ────────────────────────
# Default 8080. Override if 8080 is taken on the host.
SIGNALMAP_PORT=8080
