# =============================================================================
# SignalMap deploy environment
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
# =============================================================================

# ── Image registry ───────────────────────────────────────────────────────────
# GitHub username/org that owns the published images. The release workflow
# pushes to ghcr.io/<owner>/signalmap-{node,ui}:<version>.
SIGNALMAP_REPO_OWNER=malindarathnayake

# Pin a specific version, or leave `latest` to track the most recent tag.
# Examples: `4.0.0`, `4.1.2`. Strip the leading `v` from the git tag.
SIGNALMAP_VERSION=latest

# ── Backend mode ─────────────────────────────────────────────────────────────
# fixture: deterministic dev mode, no real LLM calls (free).
# live:    real OpenRouter + Perplexity + Cloudflare Radar (costs apply).
SIGNALMAP_BACKEND_MODE=fixture

# ── Redis (REQUIRED) ─────────────────────────────────────────────────────────
# Strong random password. Avoid URL-reserved characters (/, +, ?, #, @, :);
# use [A-Za-z0-9_-] only. Generate one:
#   openssl rand -base64 24 | tr '+/=' '_-_'
REDIS_PASSWORD=change-me-strong-random

# ── LLM keys (REQUIRED in live mode) ─────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PERPLEXITY_API_KEY=

# Optional comma-separated model fallback chain. Empty = use OpenRouter default.
SIGNALMAP_LLM_MODELS=

# ── Cloudflare Radar (optional — works unauth at lower limits) ──────────────
CLOUDFLARE_API_TOKEN=

# ── NewsAPI (optional) ───────────────────────────────────────────────────────
# Free dev plans are typically 100 requests/day; the collector polls hourly.
NEWSAPI_API_KEY=
NEWSAPI_PAGE_SIZE=20

# ── Tuning ───────────────────────────────────────────────────────────────────
# Sliding window for the news cache. Events older than this drop out of the
# visible feed. 24h is a sensible default.
SIGNALMAP_NEWS_WINDOW_HOURS=24

# Per-event confidence floor (0..1). Articles parsed below this are dropped
# with reason `low_signal_confidence` before geocoding/embedding.
SIGNALMAP_EVENT_CONFIDENCE_MIN=0.7

# Articles per RSS source per tick.
SIGNALMAP_NEWS_ITEMS_PER_SOURCE=5

# ── Cadence ──────────────────────────────────────────────────────────────────
SIGNALMAP_RSS_POLL_MINUTES=15
SIGNALMAP_BRIEF_REFRESH_MINUTES=30

# ── Budget ───────────────────────────────────────────────────────────────────
# Hard daily cap on combined LLM provider spend. The collector + cron stop
# making paid calls when this is exhausted (the day rolls at UTC midnight).
SIGNALMAP_DAILY_LLM_BUDGET_USD=2.00
SIGNALMAP_BRIEF_EVENT_EST_COST_USD=0.05
SIGNALMAP_BRIEF_PER_EVENT_RATE_LIMIT_PER_MIN=20
SIGNALMAP_BRIEF_PER_EVENT_LOCK_TIMEOUT_SECONDS=300

# ── Lease TTLs ───────────────────────────────────────────────────────────────
SIGNALMAP_COLLECTOR_LEASE_TTL_SEC=60
SIGNALMAP_CRON_LEASE_TTL_SEC=60

# ── SSE ──────────────────────────────────────────────────────────────────────
SSE_HEARTBEAT_SECONDS=20

# ── Vector store toggle ──────────────────────────────────────────────────────
# Disable to skip embedding + LanceDB (saves ~150 MB model download on first
# boot and ~1 GB of RAM on the collector). Disables semantic dedup.
SIGNALMAP_VECTOR_ENABLED=true

# ── Distill (article extraction) ─────────────────────────────────────────────
# Path inside the container — leave as-is unless you bind-mount a custom set.
SIGNALMAP_DISTILL_ROOT=/app/vendor/distill
SIGNALMAP_DISTILL_TIMEOUT_MS=15000

# ── Admin token (file-based via Docker secret) ───────────────────────────────
# Generate once on first deploy:
#   openssl rand -hex 32 > secrets/SIGNALMAP_ADMIN_TOKEN
SIGNALMAP_ADMIN_TOKEN_FILE=./secrets/SIGNALMAP_ADMIN_TOKEN

# ── Host port ────────────────────────────────────────────────────────────────
# Port the UI listens on. Override if 8080 is in use.
SIGNALMAP_PORT=8080
