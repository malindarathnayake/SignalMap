# =============================================================================
# SignalMap deploy environment
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Only the values below ACTIVE in this file are required to run a live deploy.
# Everything in the OPTIONAL OVERRIDES section at the bottom is commented out
# because the code + compose files have sensible defaults — uncomment a line
# only when you actually want to deviate from the documented default.
# =============================================================================

# ── Image registry ───────────────────────────────────────────────────────────
# GitHub username/org that owns the published images. The release workflow
# pushes to ghcr.io/<owner>/signalmap-{node,ui}:<version>.
SIGNALMAP_REPO_OWNER=malindarathnayake

# Pin a specific version, or leave `latest` to track the most recent tag.
# Examples: `4.0.0`, `4.1.2`. Strip the leading `v` from the git tag.
SIGNALMAP_VERSION=latest

# ── Backend mode ─────────────────────────────────────────────────────────────
# live:    real OpenRouter + Perplexity + Cloudflare Radar (costs apply).
# fixture: deterministic dev mode, no real LLM calls (free) — useful for
#          UI development, deploy plumbing checks, or running without keys.
SIGNALMAP_BACKEND_MODE=live

# ── Redis (REQUIRED) ─────────────────────────────────────────────────────────
# Strong random password. Avoid URL-reserved characters (/, +, ?, #, @, :);
# use [A-Za-z0-9_-] only. Generate one:
#   openssl rand -base64 24 | tr '+/=' '_-_'
REDIS_PASSWORD=change-me-strong-random

# ── Admin token (REQUIRED for the "refresh now" UI button + /brief/refresh) ──
# Without this, admin endpoints reject every request and the refresh button
# stays hidden. Generate once on first deploy:
#   openssl rand -hex 32 > secrets/SIGNALMAP_ADMIN_TOKEN
SIGNALMAP_ADMIN_TOKEN_FILE=./secrets/SIGNALMAP_ADMIN_TOKEN

# ── LLM keys (REQUIRED in live mode) ─────────────────────────────────────────
# Get keys from:
#   https://openrouter.ai/settings/keys
#   https://www.perplexity.ai/settings/api
# Both keys are validated by scripts/ops/test-env-keys.sh — run that after
# pasting to confirm the provider accepts them.
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=

# ── Optional but recommended ─────────────────────────────────────────────────
# NewsAPI: free dev plan is ~100 req/day; collector polls hourly. Without
# this the news pipeline still works (Hacker News + Dark Reading RSS), it
# just doesn't pull NewsAPI top-headlines.
NEWSAPI_API_KEY=

# Cloudflare Radar: works UNAUTH at a lower rate limit. Set this for higher
# limits + access to authenticated endpoints. Token needs:
#   Account.Cloudflare Radar:Read, Account.Account Settings:Read
CLOUDFLARE_API_TOKEN=


# =============================================================================
# OPTIONAL OVERRIDES — leave commented out unless you specifically need them
# =============================================================================
# Every line below has a code-side default. The compose files inject these
# defaults into the containers when the env var is unset. Uncommenting a
# line just lets you override the default; setting it to the documented
# default is identical to not setting it at all.

# ── Host port (default 8080) ─────────────────────────────────────────────────
#SIGNALMAP_PORT=8080

# ── OpenRouter base URL (default: official endpoint) ─────────────────────────
# Override only for self-hosted proxies (LiteLLM, custom gateway, air-gapped).
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Model selection (default: provider's choice) ─────────────────────────────
# Comma-separated fallback chain.
SIGNALMAP_LLM_MODELS=anthropic/claude-sonnet-4.6,nvidia/nemotron-3-super-120b-a12b,moonshotai/kimi-k2_6,google/gemini-3.1-pro-preview

# ── Cost / quality tuning ────────────────────────────────────────────────────
# Cap on LLM response tokens (default 768). Lower if your OpenRouter tier
# rejects 768 with 402; raise only if you see truncated event JSON.
#SIGNALMAP_LLM_MAX_OUTPUT_TOKENS=768

# Confidence floor 0..1 (default 0.7). Articles below this are dropped as
# low_signal_confidence. Lower = more events, more noise.
#SIGNALMAP_EVENT_CONFIDENCE_MIN=0.7

# Cosine-similarity threshold for semantic dedup (default 0.72). Lower
# (e.g. 0.65) = tighter dedup, more "different sources, same event" collapses.
#SIGNALMAP_VECTOR_MIN_SCORE=0.72

# ── Window + cadence (defaults: 24h window, 6h cold-boot, 15min RSS, 30min brief) ──
#SIGNALMAP_NEWS_WINDOW_HOURS=24
#SIGNALMAP_NEWS_COLD_BOOT_HOURS=6
#SIGNALMAP_NEWS_ITEMS_PER_SOURCE=5
#SIGNALMAP_RSS_POLL_MINUTES=15
#SIGNALMAP_BRIEF_REFRESH_MINUTES=30

# ── Budget (default $2/day) ──────────────────────────────────────────────────
#SIGNALMAP_DAILY_LLM_BUDGET_USD=2.00

# ── Vector store ─────────────────────────────────────────────────────────────
# Set to false to disable embeddings + LanceDB entirely (no semantic dedup).
#SIGNALMAP_VECTOR_ENABLED=true
# Embedding model: default `openai/text-embedding-3-small` routes via
# OpenRouter (no separate key). Anything not prefixed `openai/` falls back
# to embedding_unavailable.
#SIGNALMAP_EMBEDDING_MODEL=openai/text-embedding-3-small
#SIGNALMAP_EMBEDDING_DIM=1536

# ── NewsAPI page size (default 20) ───────────────────────────────────────────
#NEWSAPI_PAGE_SIZE=20

# ── Distill (path inside container — only override for custom bind-mounts) ───
#SIGNALMAP_DISTILL_ROOT=/app/vendor/distill
#SIGNALMAP_DISTILL_TIMEOUT_MS=15000

# ── Worker leases + SSE heartbeat (defaults are fine for almost all setups) ──
#SIGNALMAP_COLLECTOR_LEASE_TTL_SEC=60
#SIGNALMAP_CRON_LEASE_TTL_SEC=60
#SSE_HEARTBEAT_SECONDS=20

# ── Brief per-event tuning (defaults: $0.05 est cost, 20/min, 5min lock) ─────
#SIGNALMAP_BRIEF_EVENT_EST_COST_USD=0.05
#SIGNALMAP_BRIEF_PER_EVENT_RATE_LIMIT_PER_MIN=20
#SIGNALMAP_BRIEF_PER_EVENT_LOCK_TIMEOUT_SECONDS=300
