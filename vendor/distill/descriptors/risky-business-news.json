{
  "name": "risky-business-news",
  "version": "1.0.0",
  "description": "Risky Business News article pages",
  "url_pattern": "https://risky.biz/{slug}",
  "base_url": "https://risky.biz/",
  "root": "html",
  "cleanup": {
    "remove_selectors": [
      "script",
      "style",
      "noscript",
      "nav",
      "header nav",
      "footer",
      "aside",
      ".gh-readmore",
      ".gh-comments",
      ".gh-content > p:first-child",
      "h3[id^='sponsor-section'] + p",
      "h3[id^='sponsor-section']",
      ".kg-card",
      "audio",
      ".playerTitle",
      ".player-controls",
      ".playPauseBtn",
      "article"
    ]
  },
  "fields": {
    "title": {
      "selector": ".post-title",
      "extract": "text",
      "required": true
    },
    "articleBody": {
      "selector": "div.feed.post-content",
      "extract": "text",
      "required": true
    },
    "sourceName": {
      "selector": "body",
      "extract": "text",
      "regex": "(Risky Business)",
      "required": true
    },
    "dek": {
      "selector": "div.feed.post-content > p",
      "extract": "text",
      "required": false
    },
    "author": {
      "selector": "div.feed.post-content strong",
      "extract": "text",
      "required": false
    },
    "publishedAt": {
      "selector": "div.feed.post-content > h3:nth-of-type(2)",
      "extract": "text",
      "required": false
    },
    "updatedAt": {
      "selector": "meta[property='article:modified_time']",
      "extract": "attr",
      "attr": "content",
      "required": false
    }
  },
  "metadata": {
    "canonicalUrl": {
      "source": "input_url"
    }
  }
}
