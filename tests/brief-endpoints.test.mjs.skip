/**
 * Integration tests for brief endpoints (global, event, health, refresh).
 *
 * Requires a Redis 7 server at REDIS_URL. Suite is skipped when unset.
 * Run:
 *   REDIS_URL=redis://localhost:6380 npx tsx --test tests/brief-endpoints.test.mjs
 */

import { before, after, beforeEach, describe, it } from 'node:test';
import assert from 'node:assert/strict';
import http from 'node:http';
import { createRedisAdapter } from '../src/server/lib/redis.ts';
import { handleSignalMapBriefGlobal } from '../server/api/routes/signalmap-brief-global.ts';
import {
  handleSignalMapBriefEvent,
  setSynthesizePerEventBrief,
} from '../server/api/routes/signalmap-brief-event.ts';
import { handleSignalMapBriefHealth } from '../server/api/routes/signalmap-brief-health.ts';
import {
  handleSignalMapBriefRefresh,
  setRunOnce,
} from '../server/api/routes/signalmap-brief-refresh.ts';

const REDIS_URL = process.env.REDIS_URL;
let skip = !REDIS_URL;

if (!REDIS_URL) {
  console.warn('[brief-endpoints.test] REDIS_URL not set — skipping suite');
}

const GLOBAL_KEY = 'signalmap:brief:global';

/** @type {import('../src/server/lib/brief-pipeline.ts').BriefResult} */
const FIXTURE_BRIEF = {
  bullets: ['Global tensions rose sharply today.', 'Markets responded with a sell-off.'],
  sources: [{ label: 'Reuters', url: 'https://reuters.com/article/1' }],
  generatedAt: new Date(Date.now() - 60_000).toISOString(),
  model: 'anthropic/claude-sonnet-4.6',
  warnings: [],
  degraded: false,
};

function makeRequest(server, method, path, headers = {}) {
  return new Promise((resolve, reject) => {
    const addr = server.address();
    const options = {
      hostname: '127.0.0.1',
      port: addr.port,
      path,
      method,
      headers,
    };
    const req = http.request(options, (res) => {
      let body = '';
      res.on('data', (chunk) => (body += chunk));
      res.on('end', () => resolve({ statusCode: res.statusCode, headers: res.headers, body }));
    });
    req.on('error', reject);
    req.end();
  });
}

describe('Brief endpoints', { skip }, () => {
  let adapter;
  let server;

  before(async () => {
    adapter = createRedisAdapter({ url: REDIS_URL });
    try {
      await adapter.incr('signalmap:test:probe:brief-ep');
      await adapter.del('signalmap:test:probe:brief-ep');
    } catch (err) {
      skip = true;
      console.warn('[brief-endpoints.test] Redis unreachable:', err?.message);
      return;
    }

    server = http.createServer(async (req, res) => {
      const url = req.url ?? '/';
      if (url === '/api/signalmap/brief/global' || url === '/api/signalmap/brief') {
        return handleSignalMapBriefGlobal(req, res);
      }
      if (url.startsWith('/api/signalmap/brief/event/')) {
        return handleSignalMapBriefEvent(req, res);
      }
      if (url === '/api/signalmap/brief/health') {
        return handleSignalMapBriefHealth(req, res);
      }
      if (url === '/api/signalmap/brief/refresh') {
        return handleSignalMapBriefRefresh(req, res);
      }
      res.statusCode = 404;
      res.end('not found');
    });

    await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  });

  after(async () => {
    if (server) await new Promise((resolve) => server.close(resolve));
    if (adapter) await adapter.quit();
    try {
      const { getRedisAdapter } = await import('../src/server/lib/redis.ts');
      await getRedisAdapter().quit();
    } catch { /* singleton never initialized */ }
  });

  beforeEach(async () => {
    if (skip) return;
    await adapter.del(GLOBAL_KEY);
    await adapter.del('signalmap:brief:event:abc123');
    await adapter.del('signalmap:brief:event:lock:abc123');
    await adapter.del('signalmap:brief:event:testevt');
    await adapter.del('signalmap:brief:event:lock:testevt');
    await adapter.del('signalmap:brief:event:sftest');
    await adapter.del('signalmap:brief:event:lock:sftest');
    await adapter.del('signalmap:brief:event:rltest');
    await adapter.del('signalmap:brief:event:lock:rltest');
    await adapter.del('signalmap:brief:event:cached-event');
    await adapter.del('signalmap:brief:event:lock:cached-event');
    await adapter.del('signalmap:news:v1');
  });

  it('1. global brief MISS — returns 200 + X-Cache: MISS + degraded:true', async (t) => {
    const resp = await makeRequest(server, 'GET', '/api/signalmap/brief/global');
    assert.equal(resp.statusCode, 200);
    assert.equal(resp.headers['x-cache'], 'MISS');
    const body = JSON.parse(resp.body);
    assert.deepEqual(body.bullets, []);
    assert.equal(body.degraded, true);
    assert.ok(body.warnings.includes('no_brief_yet'));
  });

  it('2. global brief HIT — returns 200 + X-Cache: HIT + body matches', async (t) => {
    await adapter.setJson(GLOBAL_KEY, FIXTURE_BRIEF);
    const resp = await makeRequest(server, 'GET', '/api/signalmap/brief/global');
    assert.equal(resp.statusCode, 200);
    assert.equal(resp.headers['x-cache'], 'HIT');
    const body = JSON.parse(resp.body);
    assert.equal(body.generatedAt, FIXTURE_BRIEF.generatedAt);
    assert.deepEqual(body.bullets, FIXTURE_BRIEF.bullets);
  });

  it('3a. health endpoint — no brief → lastGeneratedAt and nextScheduledAt are null', async (t) => {
    const resp = await makeRequest(server, 'GET', '/api/signalmap/brief/health');
    assert.equal(resp.statusCode, 200);
    const body = JSON.parse(resp.body);
    assert.equal(body.lastGeneratedAt, null);
    assert.equal(body.nextScheduledAt, null);
    assert.equal(typeof body.dailySpendUsd, 'number');
    assert.equal(typeof body.dailyBudgetUsd, 'number');
    assert.equal(typeof body.modelInUse, 'string');
  });

  it('3b. health endpoint — with brief → nextScheduledAt is last + 30min', async (t) => {
    await adapter.setJson(GLOBAL_KEY, FIXTURE_BRIEF);
    const resp = await makeRequest(server, 'GET', '/api/signalmap/brief/health');
    assert.equal(resp.statusCode, 200);
    const body = JSON.parse(resp.body);
    assert.equal(body.lastGeneratedAt, FIXTURE_BRIEF.generatedAt);
    const expectedNext = new Date(
      new Date(FIXTURE_BRIEF.generatedAt).getTime() + 30 * 60 * 1000,
    ).toISOString();
    assert.equal(body.nextScheduledAt, expectedNext);
  });

  it('4. per-event cache HIT — returns 200 + X-Cache: HIT', async (t) => {
    await adapter.setJson('signalmap:brief:event:abc123', FIXTURE_BRIEF);
    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/event/abc123');
    assert.equal(resp.statusCode, 200);
    assert.equal(resp.headers['x-cache'], 'HIT');
    const body = JSON.parse(resp.body);
    assert.equal(body.generatedAt, FIXTURE_BRIEF.generatedAt);
  });

  it('5. per-event cache MISS → singleflight + write → cache populated', async (t) => {
    const stubBrief = { ...FIXTURE_BRIEF, generatedAt: new Date().toISOString() };
    setSynthesizePerEventBrief(async (_id) => stubBrief);

    const savedToken = process.env.SIGNALMAP_ADMIN_TOKEN;
    const savedBudget = process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
    process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = '100';
    t.after(() => {
      if (savedToken === undefined) delete process.env.SIGNALMAP_ADMIN_TOKEN;
      else process.env.SIGNALMAP_ADMIN_TOKEN = savedToken;
      if (savedBudget === undefined) delete process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
      else process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = savedBudget;
    });

    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/event/testevt');
    assert.equal(resp.statusCode, 200);
    assert.equal(resp.headers['x-cache'], 'MISS');
    const body = JSON.parse(resp.body);
    assert.equal(body.generatedAt, stubBrief.generatedAt);

    const cached = await adapter.getJson('signalmap:brief:event:testevt');
    assert.ok(cached !== null);
    assert.equal(cached.generatedAt, stubBrief.generatedAt);
  });

  it('6. per-event 10 parallel callers → exactly 1 LLM call', async (t) => {
    let callCount = 0;
    const stubBrief = { ...FIXTURE_BRIEF, generatedAt: new Date().toISOString(), bullets: ['Parallel test'] };

    setSynthesizePerEventBrief(async (_id) => {
      callCount += 1;
      await new Promise((r) => setTimeout(r, 100));
      return stubBrief;
    });

    const savedBudget = process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
    process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = '100';
    t.after(() => {
      if (savedBudget === undefined) delete process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
      else process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = savedBudget;
    });

    const results = await Promise.all(
      Array.from({ length: 10 }, () =>
        makeRequest(server, 'POST', '/api/signalmap/brief/event/sftest'),
      ),
    );

    assert.equal(callCount, 1, `Expected exactly 1 synthesis call, got ${callCount}`);
    for (const resp of results) {
      assert.equal(resp.statusCode, 200, `Expected 200, got ${resp.statusCode}`);
      const body = JSON.parse(resp.body);
      assert.deepEqual(body.bullets, stubBrief.bullets);
    }
  });

  it('7. per-event rate limit — pre-saturate counter → expect 429', async (t) => {
    const limit = Number(process.env.SIGNALMAP_BRIEF_PER_EVENT_RATE_LIMIT_PER_MIN ?? 20);
    setSynthesizePerEventBrief(async (_id) => FIXTURE_BRIEF);

    // Pre-saturate: incr the rate-limit key past the limit
    const now = new Date();
    const yyyy = now.getUTCFullYear();
    const mm = String(now.getUTCMonth() + 1).padStart(2, '0');
    const dd = String(now.getUTCDate()).padStart(2, '0');
    const hh = String(now.getUTCHours()).padStart(2, '0');
    const min = String(now.getUTCMinutes()).padStart(2, '0');
    const rlKey = `signalmap:rl:event-brief:127.0.0.1:${yyyy}-${mm}-${dd}T${hh}:${min}`;
    await adapter.del(rlKey);
    for (let i = 0; i < limit + 1; i++) {
      await adapter.incr(rlKey);
    }
    await adapter.expire(rlKey, 60);

    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/event/rltest');
    assert.equal(resp.statusCode, 429);
    const body = JSON.parse(resp.body);
    assert.equal(body.error.code, 'rate_limited');
    assert.ok(typeof body.error.retry_after_seconds === 'number');

    await adapter.del(rlKey);
  });

  it('8. admin refresh: 503 when SIGNALMAP_ADMIN_TOKEN unset', async (t) => {
    const saved = process.env.SIGNALMAP_ADMIN_TOKEN;
    delete process.env.SIGNALMAP_ADMIN_TOKEN;
    t.after(() => {
      if (saved === undefined) delete process.env.SIGNALMAP_ADMIN_TOKEN;
      else process.env.SIGNALMAP_ADMIN_TOKEN = saved;
    });

    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/refresh', {
      'X-SignalMap-Admin-Token': 'anything',
    });
    assert.equal(resp.statusCode, 503);
    const body = JSON.parse(resp.body);
    assert.equal(body.error.code, 'admin_token_not_configured');
  });

  it('9. admin refresh: 401 when token mismatch', async (t) => {
    const saved = process.env.SIGNALMAP_ADMIN_TOKEN;
    process.env.SIGNALMAP_ADMIN_TOKEN = 'correct-token';
    t.after(() => {
      if (saved === undefined) delete process.env.SIGNALMAP_ADMIN_TOKEN;
      else process.env.SIGNALMAP_ADMIN_TOKEN = saved;
    });

    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/refresh', {
      'X-SignalMap-Admin-Token': 'wrong-token',
    });
    assert.equal(resp.statusCode, 401);
    const body = JSON.parse(resp.body);
    assert.equal(body.error.code, 'unauthorized');
  });

  it('10. admin refresh: 200 when token correct + injected runOnce returns brief', async (t) => {
    const saved = process.env.SIGNALMAP_ADMIN_TOKEN;
    process.env.SIGNALMAP_ADMIN_TOKEN = 'my-secret-token';
    t.after(() => {
      if (saved === undefined) delete process.env.SIGNALMAP_ADMIN_TOKEN;
      else process.env.SIGNALMAP_ADMIN_TOKEN = saved;
    });

    const stubBrief = { ...FIXTURE_BRIEF, generatedAt: new Date().toISOString() };
    setRunOnce(async () => stubBrief);

    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/refresh', {
      'X-SignalMap-Admin-Token': 'my-secret-token',
    });
    assert.equal(resp.statusCode, 200);
    const body = JSON.parse(resp.body);
    assert.equal(body.generatedAt, stubBrief.generatedAt);
  });

  it('11. admin refresh: 502 when injected runOnce throws', async (t) => {
    const saved = process.env.SIGNALMAP_ADMIN_TOKEN;
    process.env.SIGNALMAP_ADMIN_TOKEN = 'my-secret-token';
    t.after(() => {
      if (saved === undefined) delete process.env.SIGNALMAP_ADMIN_TOKEN;
      else process.env.SIGNALMAP_ADMIN_TOKEN = saved;
    });

    setRunOnce(async () => {
      throw new Error('LLM exploded');
    });

    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/refresh', {
      'X-SignalMap-Admin-Token': 'my-secret-token',
    });
    assert.equal(resp.statusCode, 502);
    const body = JSON.parse(resp.body);
    assert.equal(body.error.code, 'refresh_failed');
    assert.ok(body.error.message.includes('LLM exploded'));
  });

  it('12. per-event: POST body with title is forwarded to synthesizePerEvent input', async (t) => {
    let capturedInput = null;

    setSynthesizePerEventBrief(async (input) => {
      capturedInput = input;
      return { ...FIXTURE_BRIEF, generatedAt: new Date().toISOString() };
    });

    const savedBudget = process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
    process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = '100';
    t.after(() => {
      if (savedBudget === undefined) delete process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
      else process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = savedBudget;
    });

    await adapter.del('signalmap:brief:event:bodytest');
    await adapter.del('signalmap:brief:event:lock:bodytest');

    const addr = server.address();
    const bodyStr = JSON.stringify({ title: 'test event' });
    const resp = await new Promise((resolve, reject) => {
      const options = {
        hostname: '127.0.0.1',
        port: addr.port,
        path: '/api/signalmap/brief/event/bodytest',
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Content-Length': Buffer.byteLength(bodyStr),
        },
      };
      const req = http.request(options, (res) => {
        let body = '';
        res.on('data', (chunk) => (body += chunk));
        res.on('end', () => resolve({ statusCode: res.statusCode, headers: res.headers, body }));
      });
      req.on('error', reject);
      req.write(bodyStr);
      req.end();
    });

    assert.equal(resp.statusCode, 200, `Expected 200, got ${resp.statusCode}: ${resp.body}`);
    assert.ok(capturedInput !== null, 'synthesizePerEventBrief should have been called');
    assert.equal(capturedInput.title, 'test event', `Expected title 'test event', got: ${capturedInput.title}`);
    assert.equal(capturedInput.id, 'bodytest', `Expected id 'bodytest', got: ${capturedInput.id}`);

    await adapter.del('signalmap:brief:event:bodytest');
    await adapter.del('signalmap:brief:event:lock:bodytest');
  });

  it('13. per-event: missing POST body is enriched from cached signal event', async (t) => {
    let capturedInput = null;

    setSynthesizePerEventBrief(async (input) => {
      capturedInput = input;
      return { ...FIXTURE_BRIEF, generatedAt: new Date().toISOString() };
    });

    const savedBudget = process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
    process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = '100';
    t.after(() => {
      if (savedBudget === undefined) delete process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD;
      else process.env.SIGNALMAP_DAILY_LLM_BUDGET_USD = savedBudget;
    });

    await adapter.setJson('signalmap:news:v1', {
      events: [
        {
          id: 'cached-event',
          title: 'cPanel authentication bypass exploited in the wild',
          summary: 'Threat actors are actively exploiting a cPanel authentication bypass vulnerability.',
          category: 'cyber',
          severity: 'high',
          locations: [{ name: 'Global', scope: 'unknown' }],
          sources: [{ label: 'Risky Business News', url: 'https://risky.biz/RBNEWS558' }],
        },
      ],
    });

    const resp = await makeRequest(server, 'POST', '/api/signalmap/brief/event/cached-event');

    assert.equal(resp.statusCode, 200, `Expected 200, got ${resp.statusCode}: ${resp.body}`);
    assert.ok(capturedInput !== null, 'synthesizePerEventBrief should have been called');
    assert.equal(capturedInput.title, 'cPanel authentication bypass exploited in the wild');
    assert.equal(capturedInput.summary, 'Threat actors are actively exploiting a cPanel authentication bypass vulnerability.');
    assert.equal(capturedInput.sourceUrl, 'https://risky.biz/RBNEWS558');
  });
});
