{
  "name": "signalmap",
  "private": true,
  "version": "4.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "lint": "biome lint ./src ./server ./tests ./e2e ./scripts",
    "lint:fix": "biome check ./src ./server ./tests ./e2e ./scripts --fix",
    "lint:unicode": "node scripts/check-unicode-safety.mjs",
    "lint:unicode:staged": "node scripts/check-unicode-safety.mjs --staged",
    "dev": "vite",
    "build:openapi": "tsx scripts/build-openapi.mjs",
    "build:types": "openapi-typescript public/openapi.yaml -o src/client/types.ts",
    "prebuild": "npm run build:openapi",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "preview": "vite preview",
    "test:data": "tsx --test tests/*.test.mjs tests/*.test.mts",
    "test:feeds": "node scripts/validate-rss-feeds.mjs",
    "start:api": "tsx server/api/index.ts",
    "start:collector": "tsx server/workers/collector.ts",
    "start:cron": "tsx server/workers/cron.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@playwright/test": "^1.52.0",
    "@types/d3": "^7.4.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^25.6.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.21.0",
    "@preact/signals": "^2.9.0",
    "@toon-format/toon": "^2.1.0",
    "apache-arrow": "^17.0.0",
    "cheerio": "^1.2.0",
    "d3": "^7.9.0",
    "d3-geo": "^3.1.1",
    "d3-zoom": "^3.0.0",
    "fast-xml-parser": "^5.3.7",
    "ioredis": "^5.10.1",
    "openapi-fetch": "^0.14.0",
    "preact": "^10.25.4",
    "topojson-client": "^3.1.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.76",
    "zod-openapi": "^4.2.4"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.7",
    "serialize-javascript": "^7.0.4",
    "node-forge": "^1.4.0",
    "srvx": "^0.11.13"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-linux-arm64-musl": "0.21.0",
    "@lancedb/lancedb-linux-x64-musl": "0.21.0"
  }
}
